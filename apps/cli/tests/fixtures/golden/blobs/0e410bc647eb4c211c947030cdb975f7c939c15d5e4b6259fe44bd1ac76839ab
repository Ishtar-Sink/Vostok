# Configurações gerais do harness.
# Caminhos relativos partem da raiz do harness (a pasta que contém `config/`).

paths:
  root: ../../
  specs: ./work/specs
  plans: ./work/plans
  tasks: ./work/tasks
  templates: ./templates
  scripts: ./scripts
  docs: ../../docs
  agent_memory: ./memory
  state: ./.state          # estado local de cada clone, fora do git
  archive: ./work/.archive    # specs finalizadas, com tarefas e evidências, fora do git
  finalize: ./work/finalize    # conteúdo e documentos de uma spec antes do arquivamento
  spec_docs: ../../docs/specs  # documentos publicados de cada spec finalizada (executivo e técnico)
