* { box-sizing: border-box; }
html { background: var(--color-bg); }
body {
  margin: 0; background: var(--color-bg); color: var(--color-ink);
  font: 400 14px/1.55 var(--font-body); -webkit-font-smoothing: antialiased;
}
code { font: .92em var(--font-mono); background: var(--color-surface-2); padding: 1px 5px; border-radius: 4px; }
p { margin: 0 0 12px; }
h2 { font-size: 20px; margin: 0 0 5px; letter-spacing: -.015em; text-wrap: pretty; }
h3 { font-size: 15px; margin: 0 0 8px; letter-spacing: -.008em; }

/* Cabeçalho em faixa */
.hd { background: linear-gradient(160deg, var(--color-head) 0%, var(--color-head-2) 100%); color: var(--color-head-ink);
      padding: 20px clamp(16px, 4vw, 40px) 0; }
.hd-top, .hd-body { max-width: 1120px; margin: 0 auto; }
.hd-top { display: flex; align-items: center; gap: 12px; }
.mark { width: 26px; height: 26px; flex: none; }
.wm { font-weight: 700; font-size: 15px; letter-spacing: -.01em; line-height: 1.15; }
.wm small { display: block; font-weight: 500; font-size: 11px; color: var(--color-head-muted); letter-spacing: .02em; }
.hd-sp { flex: 1; }
.tbtn { background: rgba(255,255,255,.09); color: var(--color-head-ink); border: 1px solid rgba(255,255,255,.18);
        border-radius: 999px; padding: 6px 13px; font: inherit; font-size: 12px; cursor: pointer; }
.tbtn:hover { background: rgba(255,255,255,.17); }
.tbtn:focus-visible { outline: 2px solid var(--color-head-muted); outline-offset: 2px; }
.hd-body { padding: 26px 0 28px; }
.eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; color: var(--color-head-muted); margin: 0 0 9px; }
.hd-body h1 { font-size: clamp(26px, 3.5vw, 35px); line-height: 1.12; margin: 0 0 12px; letter-spacing: -.024em; text-wrap: pretty; }
.lede { font-size: 14.5px; color: var(--color-head-muted); max-width: 900px; }
.lede p:last-child { margin-bottom: 0; }
.lede strong { color: var(--color-head-ink); font-weight: 600; }
.lede code { background: rgba(255,255,255,.1); color: var(--color-head-ink); }

main { max-width: 1120px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 40px) 56px; }
.panel { padding: 30px 0 4px; }
.tabs .panel:not(.on) { display: none; }
.sec-h { margin: 0 0 14px; }
.sec-h > p { color: var(--color-muted); font-size: 13.5px; margin: 6px 0 0; }
/* Tabelas */
.tw { overflow-x: auto; border: 1px solid var(--color-line); border-radius: 14px; background: var(--color-surface); margin: 0 0 14px; }
table { border-collapse: collapse; width: 100%; min-width: 560px; }
th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: .07em; color: var(--color-muted); font-weight: 700;
     padding: 11px 14px; border-bottom: 1px solid var(--color-line); background: var(--color-surface-2); white-space: nowrap; }
td { padding: 11px 14px; border-bottom: 1px solid var(--color-line); font-size: 13.5px; vertical-align: top; }
tr:last-child td { border-bottom: 0; }
td.strong { font-weight: 600; }

.na { color: var(--color-muted); font-style: italic; }

/* Abas */
.nav { position: sticky; top: 0; z-index: 20; background: var(--color-surface); border-bottom: 1px solid var(--color-line); }
.nav-in { max-width: 1120px; margin: 0 auto; display: flex; gap: 2px; padding: 0 clamp(16px, 4vw, 40px); overflow-x: auto; }
.nav a { display: block; padding: 12px 12px 10px; font-size: 12.5px; color: var(--color-muted); text-decoration: none;
         border-bottom: 2px solid transparent; white-space: nowrap; }
.nav a:hover { color: var(--color-ink); }
.nav a.on { color: var(--color-primary); border-bottom-color: var(--color-primary); font-weight: 600; }
.nav a:focus-visible { outline: 2px solid var(--color-primary); outline-offset: -3px; border-radius: 3px; }

/* Diffs */
details.dfile { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 9px; margin: 0 0 8px; overflow: hidden; }
details.dfile[open] { border-color: var(--color-primary); }
details.dfile > summary { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; padding: 11px 15px; cursor: pointer; list-style: none; }
details.dfile > summary::-webkit-details-marker { display: none; }
details.dfile > summary::before { content: "+"; font-family: var(--font-mono); color: var(--color-primary); font-weight: 700; flex: none; width: 11px; }
details.dfile[open] > summary::before { content: "\2212"; }
details.dfile > summary:hover { background: var(--color-surface-2); }
details.dfile > summary:focus-visible { outline: 2px solid var(--color-primary); outline-offset: -2px; }
details.dfile > summary .path { font: 600 12.5px var(--font-mono); flex: 1; min-width: 200px; overflow-wrap: anywhere; }
.dbody { border-top: 1px solid var(--color-line); }
.dbody > p { margin: 0; padding: 12px 15px; color: var(--color-muted); font-size: 13px; }
.dbody .tw { border: 0; border-radius: 0; margin: 0; }
table.diff { table-layout: fixed; min-width: 760px; font: 12px/1.5 var(--font-mono); }
table.diff td { padding: 0 8px; border-bottom: 0; font-size: 12px; vertical-align: top; }
table.diff col.cln { width: 48px; }
table.diff td.ln { width: 48px; text-align: right; color: var(--color-muted); user-select: none; background: var(--color-surface-2); }
table.diff td.code { white-space: pre-wrap; overflow-wrap: anywhere; }
table.diff td.code.del { background: var(--color-diff-del-soft); }
table.diff td.code.add { background: var(--color-diff-add-soft); }
table.diff td.code.empty { background: var(--color-surface-2); }
table.diff tr:has(td.code.del) td.ln:nth-child(1) { color: var(--color-diff-del); }
table.diff tr:has(td.code.add) td.ln:nth-child(3) { color: var(--color-diff-add); }
table.diff tr.hunk td { background: var(--color-primary-soft); color: var(--color-muted); padding: 4px 10px; }
table.diff td.code:nth-child(2) { border-right: 1px solid var(--color-line); }

/* Etiquetas e notas */
.tag { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .02em; padding: 2px 8px; border-radius: 999px;
       white-space: nowrap; background: var(--color-surface-2); color: var(--color-muted); }
.chip { display: inline-block; font: 700 11.5px var(--font-mono); color: var(--color-primary); background: var(--color-primary-soft);
