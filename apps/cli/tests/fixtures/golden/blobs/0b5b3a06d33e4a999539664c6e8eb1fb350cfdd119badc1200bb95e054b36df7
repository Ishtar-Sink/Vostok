.tag.criar { background: var(--color-ok-soft); color: var(--color-ok); }
.tag.alterar { background: var(--color-primary-soft); color: var(--color-primary); }
.tag.remover { background: var(--color-crit-soft); color: var(--color-crit); }
td.path { font: 12.5px var(--font-mono); overflow-wrap: anywhere; }
td.mono { font: 12.5px var(--font-mono); white-space: nowrap; }
.md { font-size: 14px; }
.md ul, .md ol { margin: 0 0 12px; padding-left: 22px; }
.md li { margin: 4px 0; }
.md li::marker { color: var(--color-primary); }
.note { background: var(--color-primary-soft); border-radius: 9px; padding: 15px 18px; font-size: 13.5px; margin: 20px 0 0; }
.note > b:first-child { display: block; text-transform: uppercase; font-size: 10.5px; letter-spacing: .08em; margin-bottom: 4px; color: var(--color-primary); }
.note p:last-child, .note ul:last-child, .note ol:last-child { margin-bottom: 0; }
.note ul, .note ol { margin: 0 0 10px; padding-left: 20px; }
.note.warn { background: var(--color-warn-soft); }
.note.warn > b:first-child { color: var(--color-warn); }

/* Conteúdo em Markdown */
.md { font-size: 14px; }
.md ul, .md ol { margin: 0 0 12px; padding-left: 22px; }
.md li { margin: 4px 0; }
.md li::marker { color: var(--color-primary); }

footer { max-width: 1120px; margin: 0 auto; padding: 24px clamp(16px, 4vw, 40px) 44px; border-top: 1px solid var(--color-line);
