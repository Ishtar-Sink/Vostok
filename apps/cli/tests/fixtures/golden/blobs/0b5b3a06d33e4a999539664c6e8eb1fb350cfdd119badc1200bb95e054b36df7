<script>
(function () {
  var root = document.documentElement;
  var button = document.getElementById("theme-toggle");
  button.addEventListener("click", function () {
    var light = root.getAttribute("data-theme") !== "light";
    root.setAttribute("data-theme", light ? "light" : "dark");
    button.textContent = light ? "Tema escuro" : "Tema claro";
    button.setAttribute("aria-pressed", light ? "true" : "false");
  });

  // Abas: sem JavaScript, todas as seções aparecem em sequência e os links levam a cada uma.
  // Links do menu sem painel correspondente saem do menu.
  var tabs = Array.prototype.slice.call(document.querySelectorAll(".nav a[data-tab]")).filter(function (a) {
    if (document.getElementById("p-" + a.getAttribute("data-tab"))) return true;
    a.parentNode.removeChild(a);
    return false;
  });
  var panels = Array.prototype.slice.call(document.querySelectorAll(".panel"));
  // O hash da aba (#diffs) não coincide com o id da seção (p-diffs): o link continua compartilhável
  // e o navegador não rola até a seção antes de ela aparecer, o que esconderia o cabeçalho.
  function show(id) {
    if (!tabs.length) return;
    id = id.replace(/^p-/, "");
    if (!document.getElementById("p-" + id)) id = tabs[0].getAttribute("data-tab");
    tabs.forEach(function (a) {
      var on = a.getAttribute("data-tab") === id;
      a.classList.toggle("on", on);
      a.setAttribute("aria-selected", on ? "true" : "false");
    });
    panels.forEach(function (p) { p.classList.toggle("on", p.id === "p-" + id); });
  }
  tabs.forEach(function (a) {
    a.addEventListener("click", function (ev) {
      ev.preventDefault();
      show(a.getAttribute("data-tab"));
      history.replaceState(null, "", "#" + a.getAttribute("data-tab"));
    });
  });
  document.body.classList.add("tabs");
  show((location.hash || "").replace("#", ""));

  // Na impressão, os blocos de diff fechados abrem para o conteúdo sair inteiro no papel.
  var closed = [];
  window.addEventListener("beforeprint", function () {
    closed = Array.prototype.slice.call(document.querySelectorAll("details.dfile:not([open])"));
    closed.forEach(function (d) { d.open = true; });
  });
  window.addEventListener("afterprint", function () {
    closed.forEach(function (d) { d.open = false; });
  });
})();
</script>
