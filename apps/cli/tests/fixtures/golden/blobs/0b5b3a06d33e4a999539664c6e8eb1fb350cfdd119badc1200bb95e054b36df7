  --color-warn-soft: #fdf1e3;
  --color-crit: #b91c3c;
  --color-crit-soft: #fbe5ea;
  --color-diff-add: #047857;
  --color-diff-add-soft: #e3f4ec;
  --color-diff-del: #b91c3c;
