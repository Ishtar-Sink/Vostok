  --color-bg: #f7f5fb;
  --color-surface: #ffffff;
  --color-surface-2: #f1edf8;
  --color-ink: #1d1729;
  --color-muted: #6a6280;
  --color-line: #e3ddee;
  --color-primary: #6d28d9;
